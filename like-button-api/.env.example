# ============================================================
# Like Button API – Environment Configuration
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to version control.
# ============================================================

# Server
NODE_ENV=production
PORT=3000

# ── JWT Settings ─────────────────────────────────────────────
# 64-byte hex secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRY=1h
# Comma-separated list of previous secrets for key rotation
JWT_PREVIOUS_SECRETS=

# ── API Key HMAC Secret ───────────────────────────────────────
# 32-byte hex secret for HMAC-signing API keys
API_KEY_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── Request Signing ───────────────────────────────────────────
# 32-byte hex secret for HMAC-SHA256 request/response signing
SIGNING_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── AES-256-GCM Encryption ────────────────────────────────────
# Exactly 32-byte hex key (64 hex chars) for AES-256
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── Vote Record Signing ───────────────────────────────────────
# Secret for signing individual vote records
VOTE_SIGNING_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── Audit Log Sealing ─────────────────────────────────────────
# Secret for HMAC-sealing the audit log hash chain
AUDIT_LOG_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── Database ─────────────────────────────────────────────────
# Path to SQLite database file (use absolute path in production)
DB_PATH=./data/likes.db

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://example.com)
# Use * for development ONLY
CORS_ALLOWED_ORIGINS=https://example.com

# ── Rate Limiting ─────────────────────────────────────────────
# Window in milliseconds (default 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=30
# Max vote attempts per window per device
VOTE_RATE_LIMIT_MAX=5

# ── Replay Attack Prevention ──────────────────────────────────
# How many seconds a signed request remains valid (default 300 = 5 min)
REQUEST_TIMESTAMP_TOLERANCE_SECS=300

# ── Admin JWT ─────────────────────────────────────────────────
# Separate secret for admin-scoped JWT tokens
ADMIN_JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_ADMIN_SECRET

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
